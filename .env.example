# Port the site listens on
PORT=3000

# Public https address of this site (used in guides, BuiltByBit/Tebex URLs and the
# generated Java class). Can also be set later in Dashboard -> Settings.
PUBLIC_URL=https://license.example.com

# Set to true ONLY when running behind a reverse proxy (Caddy, Nginx, Cloudflare)
# so the real client IP is read from X-Forwarded-For. Leave false otherwise,
# or people could fake their IP to dodge the blacklist and server limits.
TRUST_PROXY=false

# Where the SQLite database and RSA keys are stored
DATA_DIR=./data

# ---- Owner login ----
# The site is protected by a single password. On first run an owner account is
# created automatically with these values; log in with the password at /login.
# Change the password any time in Dashboard -> Settings.
OWNER_USERNAME=owner
OWNER_PASSWORD=Je!onek23

# ---- Obfuscation (Obfuscate / Auto setup pages) ----
# ProGuard is downloaded into ./vendor on first use. To install it ahead of time:
#   node scripts/install-proguard.mjs
# Set to false to disable the automatic download (then install it manually).
# PROGUARD_AUTODOWNLOAD=true
# Point this at your server API jar (e.g. paper-api) for the strongest, safest
# obfuscation. Optional — without it ProGuard still produces a working jar.
# PAPER_API_JAR=/path/to/paper-api.jar
# Extra library jars for ProGuard, separated by ':' (Linux/macOS) or ';' (Windows).
# LIBRARY_JARS=/path/to/a.jar:/path/to/b.jar
